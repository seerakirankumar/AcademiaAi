# Copy this file to .env and replace every placeholder before starting the API.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=REPLACE_WITH_GENERATED_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=30

# File-backed administrator login. No SQL database is used.
# The account is created on first start if the username is not already in data/users.json.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
# Optional: defaults to data/users.json
# AUTH_USERS_FILE=data/users.json

# Frontend development URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Optional AI assistant powered by Groq. Keep this key server-side only.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
